# ============================================================
# SENTINEL 2.0 - Backend Environment Configuration Template
# ============================================================
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase PostgreSQL Configuration (Server-side ONLY - Never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Storage Driver: 'supabase' (uses PostgreSQL), 'local' (file-backed JSON store), 'memory' (in-memory)
# Defaults to 'supabase' if SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set, else 'local'
STORAGE_DRIVER=local

# Future AI & Security Configuration
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=your_jwt_secret_key_here
