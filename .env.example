# ============================================================
# SENTINEL 2.0 — Root Environment Configuration Template
# ============================================================
# Copy this file to .env at the repo root (for development convenience)
# or copy the workspace-specific templates below.
#
# NEVER commit real credentials, keys, or tokens to version control.
# Real .env files are listed in .gitignore and will NOT be committed.
# ============================================================

# ============================================================
# BACKEND — SERVER-ONLY VARIABLES (never exposed to frontend)
# ============================================================

# HTTP server port (default: 4000)
PORT=4000

# Runtime environment: development | production | test
NODE_ENV=development

# Allowed frontend origin for CORS
# Development: http://localhost:5173
# Production:  https://your-deployed-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# Storage driver: supabase | local | memory
# - supabase: uses Supabase PostgreSQL (recommended for production)
# - local:    JSON file store under backend/data/ (survives restarts)
# - memory:   volatile in-process store (used automatically in test mode)
STORAGE_DRIVER=local

# ──────────────────────────────────────────────────────────
# Supabase PostgreSQL (SERVER-ONLY — NEVER prefix with VITE_)
# ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ──────────────────────────────────────────────────────────
# Google Gemini (SERVER-ONLY — NEVER prefix with VITE_)
# ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Set to true to force the deterministic mock agent (ignores GEMINI_API_KEY)
DEMO_MODE=false

# JWT secret (reserved for future auth middleware; not yet in active use)
JWT_SECRET=your_strong_random_jwt_secret_here

# ============================================================
# FRONTEND — PUBLIC VARIABLES (safe to embed in browser bundle)
# ============================================================
# Only variables prefixed with VITE_ are exposed by Vite to the browser.
# Place these in frontend/.env (or frontend/.env.local).

# Backend API base URL consumed by the React frontend
# Development proxy: http://localhost:4000/api
# Production:        https://your-deployed-backend.onrender.com/api
VITE_API_URL=http://localhost:4000/api