# ============================================================
# SENTINEL 2.0 - Root Environment Configuration Template
# ============================================================
# Copy this file to .env in each corresponding workspace or root.
# NEVER commit real credentials, keys, or tokens to version control.

# Backend Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Frontend Configuration
VITE_API_URL=http://localhost:4000/api

# Future Phase Credentials (Server-side ONLY, never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
JWT_SECRET=your_jwt_secret_key_here
